/* =============
   Create tables
   =============
Purpose: The purpose of this script is to create total 6 tables in the Bronze schema. Three tables come 
from the CRM source and the other three come from the ERP source
The script drop the tables if they already exist and recretae them, therefore run it to redefine tables.*/

--Importing the data from CSV to the schemas--
--Tables from source CRM--
IF OBJECT_ID('Bronze.crm_cust_info', 'U') IS NULL
	DROP TABLE Bronze.crm_cust_info
CREATE TABLE Bronze.crm_cust_info (
	cst_id INT,
	cst_key NVARCHAR(50),
	cst_firstname NVARCHAR(50),
	cst_lastname NVARCHAR(50),
	cst_marital_status NVARCHAR(50),
	cst_gndr NVARCHAR(50),
	cst_create_date DATE
)

--Tables from source CRM--
IF OBJECT_ID('Bronze.crm_prd_info', 'U') IS NULL
	DROP TABLE Bronze.crm_prd_info
CREATE TABLE Bronze.crm_prd_info (
	prd_id INT,
	prd_key NVARCHAR(50),
	prd_nm NVARCHAR(50),
	prd_cost INT,
	prd_line NVARCHAR(50),
	prd_start_dt DATE,
	prd_end_dt DATE
)


--Table from source CRM--
IF OBJECT_ID('Bronze.crm_sales_details', 'U') IS NULL
	DROP TABLE Bronze.crm_sales_details
CREATE TABLE Bronze.crm_sales_details (
	sls_ord_num NVARCHAR(50),
	sls_prd_key NVARCHAR(50),
	sls_cust_id INT,
	sls_order_dt INT,
	sls_ship_dt INT,
	sls_due_dt INT,
	sls_sales INT,
	sls_quantity INT,
	sls_price INT
)


--Table from source ERP--
IF OBJECT_ID('Bronze.erp_CUST_AZ12', 'U') IS NULL
	DROP TABLE Bronze.erp_CUST_AZ12
CREATE TABLE Bronze.erp_CUST_AZ12 (
	CID NVARCHAR(50),
	BDATE DATE,
	GEN NVARCHAR(50)
)

--Table from source ERP--
IF OBJECT_ID('Bronze.erp_LOC_A101', 'U') IS NULL
	DROP TABLE Bronze.erp_LOC_A101
CREATE TABLE Bronze.erp_LOC_A101 (
	CID NVARCHAR(50),
	CNTRY NVARCHAR(50)
)

--Table from source ERP--
IF OBJECT_ID('Bronze.erp_PX_CAT_G1V2', 'U') IS NULL
	DROP TABLE Bronze.erp_PX_CAT_G1V2
CREATE TABLE Bronze.erp_PX_CAT_G1V2 (
	ID  NVARCHAR(50),
	CAT NVARCHAR(50),
	SUBCAT NVARCHAR(50),
	MAINTENANCE NVARCHAR(50),
)
