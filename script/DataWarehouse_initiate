/* ===========================
   Create Database and Schemas
   ===========================
Script purpose and description: The script is going to create a database called DataWarehouse and three schemas within it,
namely Bronze, Silver and Gold. First the code checks whether the database exists in the list of Databases by using IF EXIST().
If it does then the database is dropped and created again. In the second step the schemas are created.

Warning: This script will delete the entire Datawarehouse database if it exists meaning all the data inside it will get deleted
permanently. Therefore run it only when backup exists.
*/


--Drop and recreate the DataWarehouse database--
IF EXISTS (SELECT 1 FROM sys.databases WHERE name='DataWarehouse')
BEGIN
ALTER DATABASE DataWarehouse SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
DROP DATABASE DataWarehouse;
END;
GO

--Craete the database DataWarehouse--
CREATE DATABASE DataWarehouse
GO

--Create three Schemas in the database name Bronze, Silver, Gold--
USE DataWarehouse
GO

CREATE SCHEMA Bronze;
GO
CREATE SCHEMA Silver;
GO
CREATE SCHEMA Gold;
GO
