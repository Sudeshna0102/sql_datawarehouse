/* Bronze.sales_details*/
----------------------------------------------------
------------------------------
/*Checking the Date Columns*/
------------------------------
--Checking if thedates are Null,Negative, Outside of Range or Incomplete
SELECT
    sls_order_dt,
    sls_ship_dt,
    sls_due_dt
FROM Bronze.crm_sales_details
WHERE
    -- Order Date
    sls_order_dt IS NULL
    OR sls_order_dt <= 0
    OR LEN(CAST(sls_order_dt AS VARCHAR(8))) <> 8
    OR sls_order_dt > 20500101
    OR sls_order_dt < 19000101

    -- Ship Date
    OR sls_ship_dt IS NULL
    OR sls_ship_dt <= 0
    OR LEN(CAST(sls_ship_dt AS VARCHAR(8))) <> 8
    OR sls_ship_dt > 20500101
    OR sls_ship_dt < 19000101

    -- Due Date
    OR sls_due_dt IS NULL
    OR sls_due_dt <= 0
    OR LEN(CAST(sls_due_dt AS VARCHAR(8))) <> 8
    OR sls_due_dt > 20500101
    OR sls_due_dt < 19000101;
	
	
--Transform the date columns
SELECT 
CASE WHEN sls_order_dt=0 OR LEN(sls_order_dt)<8 THEN NULL
     ELSE CAST(CAST(sls_order_dt AS VARCHAR)AS DATE)
END sls_order_dt,
CASE WHEN sls_ship_dt=0 OR LEN(sls_ship_dt)<8 THEN NULL
     ELSE CAST(CAST(sls_ship_dt AS VARCHAR)AS DATE)
END sls_ship_dt,
CASE WHEN sls_due_dt=0 OR LEN(sls_due_dt)<8 THEN NULL
     ELSE CAST(CAST(sls_due_dt AS VARCHAR)AS VARCHAR)
END sls_due_dt
FROM Bronze.crm_sales_details


---------------------------------------------------
/*Checking the Sales, Quantity and Price Columns */
---------------------------------------------------
--Checking For Nulls or Negative Values or where The Business Logic Does Not Align
SELECT DISTINCT
sls_sales,
sls_quantity,
sls_price
FROM Bronze.crm_sales_details
WHERE sls_sales != sls_quantity * sls_price
OR sls_sales IS NULL OR sls_quantity IS NULL OR sls_price IS NULL
OR sls_sales <=0 OR sls_quantity <=0 OR sls_price <=0


--Transform
SELECT DISTINCT
sls_quantity,
CASE WHEN sls_sales IS NULL OR sls_sales<=0 OR sls_sales!=sls_price*sls_quantity
	 THEN sls_quantity * ABS(sls_price)
	 ELSE sls_sales
END sls_sales, 
CASE WHEN sls_price IS NULL OR sls_price<=0 
	 THEN sls_sales/NULLIF(sls_quantity,0)
ELSE sls_price
END sls_price
FROM Bronze.crm_sales_details


