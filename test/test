/*
===========================
CLEAN THE DATA
===========================
Purpose: The purpose of this scrpit is to test the data from Bronze Layer for Nulls, 
Empty Spaces, Standardization issues and clean them to insert into the Silver Layer
*/

----------------------------------------------------
/* Bronze.crm_cust_info*/
----------------------------------------------------
---------------------------------------
/*Check cst_id Colum */
---------------------------------------
--Find Duplicates
SELECT 
cst_id,
COUNT(*)
FROM Bronze.crm_cust_info
GROUP BY cst_id
HAVING COUNT(*)>1


--Transform Duplicates
SELECT *
FROM(
SELECT *,
ROW_NUMBER() OVER (PARTITION BY cst_id ORDER BY cst_create_date DESC) AS flag
FROM Bronze.crm_cust_info)t
WHERE flag=1


--------------------------------------------------
/* Check cst_firstname and cst_lastname Column */
--------------------------------------------------
-- Check Empty Spaces
SELECT 
cst_firstname
FROM Bronze.crm_cust_info
WHERE cst_firstname != TRIM(cst_firstname)


--From the column cst_lastname
SELECT 
cst_lastname
FROM Bronze.crm_cust_info
WHERE cst_firstname != TRIM(cst_lastname)


--Transform Empty Spaces from cst_firstname and cst_lastname
SELECT
TRIM(cst_firstname) AS cst_firstname,
TRIM(cst_lastname) AS cst_lastname
FROM Bronze.crm_cust_info


--------------------------------------------------
/* Check cst_marital_statu and cst_gndr Columns*/
--------------------------------------------------
--cst_marital_status and cst_gndr will be replaced with full names of the short forms
--Transform Empty Spaces And Replace with Full Names
SELECT
CASE WHEN UPPER(TRIM(cst_marital_status))='S' THEN 'Single'
	 WHEN UPPER(TRIM(cst_marital_status))='M' THEN 'Married'
	 ELSE 'n/a' 
END	AS cst_marital_status,
CASE WHEN UPPER(TRIM(cst_gndr))='F' THEN 'Female'
	 WHEN UPPER(TRIM(cst_gndr))='M' THEN 'Male'
	 ELSE 'n/a' 
END AS cst_gndr
FROM Bronze.crm_cust_info



-------------------------------------------------------------------------------
/* Enter Clean, Normalized and standardized Columns in Silver.crm_cust_info */
-------------------------------------------------------------------------------
INSERT INTO Silver.crm_cust_info(
cst_id,
cst_key,
cst_firstname,
cst_lastname,
cst_marital_status,
cst_gndr,
cst_create_date
)

SELECT 
cst_id,
cst_key,
TRIM(cst_firstname) AS cst_firstname,
TRIM(cst_lastname) AS cst_lastname,
CASE WHEN UPPER(TRIM(cst_marital_status))='S' THEN 'Single'
	 WHEN UPPER(TRIM(cst_marital_status))='M' THEN 'Married'
	 ELSE 'n/a' 
END	AS cst_marital_status,
CASE WHEN UPPER(TRIM(cst_gndr))='F' THEN 'Female'
	 WHEN UPPER(TRIM(cst_gndr))='M' THEN 'Male'
	 ELSE 'n/a' 
END AS cst_gndr,
cst_create_date
FROM(
SELECT *,
ROW_NUMBER() OVER (PARTITION BY cst_id ORDER BY cst_create_date DESC) AS flag
FROM Bronze.crm_cust_info)t
WHERE flag=1




----------------------------------------------------
/* Bronze.crm_prd_info */
----------------------------------------------------
---------------------------
/* Check prd_key Column */
---------------------------
--Check For Duplicates
SELECT
COUNT(*)
FROM Bronze.crm_prd_info
GROUP BY prd_id
HAVING COUNT(*)>1


--Transform the prd_key Column 
SELECT
prd_id,
REPLACE(SUBSTRING(prd_key,1,5),'-','_') AS cat_id,
SUBSTRING(prd_key,7,LEN(prd_key))AS prd_key,
prd_nm,
prd_cost,
prd_line,
prd_start_dt,
prd_end_dt
FROM Bronze.crm_prd_info


----------------------------------------
/* Check prd_nm Column */
----------------------------------------
-- Check For Empty Spaces
SELECT 
prd_nm
FROM Bronze.crm_prd_info
WHERE prd_nm != TRIM(prd_nm)


---------------------------------------
/* Check The Quality of Column prd_cost*/
----------------------------------------
--Checking NULL or negative Numbers
SELECT
prd_cost
FROM Bronze.crm_prd_info
WHERE prd_cost<0 OR prd_cost IS NULL


--Transform the NULL inro zero
SELECT
ISNULL(prd_cost,0) AS prd_cost
FROM Bronze.crm_prd_info


---------------------------------------
/* Check prd_line Column */
---------------------------------------- 
-- Transform the prd_line Column in Full Name
SELECT
CASE WHEN UPPER(TRIM(prd_line))='R' THEN 'Road'
	 WHEN UPPER(TRIM(prd_line))='M' THEN 'Mountain'
	 WHEN UPPER(TRIM(prd_line)) ='S' THEN 'Other Sales'
	 WHEN UPPER(TRIM(prd_line))='T' Then 'Touring'
Else 'n/a'
END as prd_line,
prd_start_dt,
prd_end_dt
FROM Bronze.crm_prd_info


---------------------------------------
/* Check Quality of the Date Colums*/
---------------------------------------- 
--Checking prd_end_dt comes before prd_start_dt
SELECT *
FROM Bronze.crm_prd_info
WHERE prd_end_dt<prd_start_dt


--Transform these dates
SELECT
CAST(prd_start_dt AS DATE) AS prd_start_dt,
DATEADD(Day,-1,CAST(LEAD(prd_start_dt)OVER(PARTITION BY prd_key ORDER BY prd_start_dt) AS DATE))AS prd_end_dt
FROM Bronze.crm_prd_info


-------------------------------------------------------------------------------
/* Enter Clean, Normalized and standardized Columns in Silver.crm_prd_info */
-------------------------------------------------------------------------------
INSERT INTO Silver.crm_prd_info(
	prd_id,
	prd_key,
	cat_id,
	prd_nm,
	prd_cost,
	prd_line,
	prd_start_dt,
	prd_end_dt
)
SELECT
prd_id,
REPLACE(SUBSTRING(prd_key,1,5),'-','_') AS cat_id,
SUBSTRING(prd_key,7,LEN(prd_key))AS prd_key,
prd_nm,
ISNULL(prd_cost,0) AS prd_cost,
CASE WHEN UPPER(TRIM(prd_line))='R' THEN 'Road'
	 WHEN UPPER(TRIM(prd_line))='M' THEN 'Mountain'
	 WHEN UPPER(TRIM(prd_line)) ='S' THEN 'Other Sales'
	 WHEN UPPER(TRIM(prd_line))='T' Then 'Touring'
Else 'n/a'
END as prd_line,
CAST(prd_start_dt AS DATE) AS prd_start_dt,
DATEADD(Day,-1,CAST(LEAD(prd_start_dt)OVER(PARTITION BY prd_key ORDER BY prd_start_dt) AS DATE))AS prd_end_dt
FROM Bronze.crm_prd_info




