/*
======================================
Customer Report
======================================
Purpose: This report consolidates key product metrics and behaviour

Highlight: 
1. Gathers essential fields such as product name, category, subcategory and cost details.
2. Segments products into categories based on performance (High, Mid and Low) 
3. Aggregates product-level metrics:
		- total orders
		- total sales
		- total quantity sold
		- total unique customers
		- span (in months)
4. Calculate valuable KPIs:
		- recovery (months since last order)
		- average order revenue
		- average monthly revenue
=======================================
*/
WITH cte_base_query AS(
--CTE for Transformation
SELECT 
f.product_key,
f.order_date,
f.shipping_date,
f.due_date,
f.sales,
f.quantity,
f.price,
p.product_surkey,
p.product_name,
p.product_category,
p.product_subcategory,
p.product_cost
FROM Gold_view_factsales f
LEFT JOIN Gold_view_dimproduct p
ON p.product_surkey=f.product_surkey
WHERE f.order_date IS NOT NULL
)
, cte_product_aggregation AS(
--CTE for aggregates
SELECT 
product_surkey,
product_name,
COUNT(DISTINCT order_number)AS total_orders,
SUM(sales) AS total_sales,
SUM(quantity) AS total_quantity,
COUNT(DISTINCT customer_key) AS total_unique_customer,
MAX(order_date) AS last_order_date, 
DATEDIFF(month, MIN(order_date), MAX(order_date)) AS Span
FROM cte_base_query
GROUP BY product_surkey,
)

SELECT *
FROM cte_base_query
