/*
======================================
Customer Report
======================================
Purpose: This report consolidates key customer metrics and behaviour

Highlight: 
1. Gathers essential fields such as name, age and transaction details.
2. Segments customers into categories (VIP, Regular, New) and age groups.
3. Aggregates customer-level metrics:
		- total orders
		- total sales
		- total quantity purchased
		- total products
		- span (in months)
4. Calculate valuable KPIs:
		- recovery (months since last order)
		- average order value
		- average monthly spend
=======================================
*/
DROP VIEW Gold.report_view_customer
CREATE VIEW Gold.report_view_customer AS
WITH cte_base_query AS(
--CTE for transformation
SELECT
f.order_number,
f.product_key,
f.order_date,
f.sales,
f.quantity,
dc.customer_surkey,
dc.customer_number,
CONCAT(dc.first_name,' ',dc.last_name)AS customer_name,
DATEDIFF(year,dc.birthday,GETDATE()) age
FROM Gold_view_factsales f
LEFT JOIN Gold_view_dimcustomer dc
ON dc.customer_surkey = f.customer_surkey
WHERE f.order_date IS NOT NULL
)
, cte_customer_aggregation AS(
--CTE for aggregate results
SELECT
customer_surkey,
customer_number,
customer_name,
age,
COUNT(DISTINCT order_number)AS total_orders,
SUM(sales) AS total_sales,
SUM(quantity) AS total_quantity,
COUNT(DISTINCT product_key) AS total_products,
MAX(order_date) AS last_order_date, 
DATEDIFF(month, MIN(order_date), MAX(order_date)) AS Span
FROM cte_base_query
GROUP BY customer_surkey,
customer_number,
customer_name,
age
)

, cte_partition AS(
--CTE for categorization
SELECT
customer_surkey,
customer_number,
customer_name,
age,
total_orders,
total_sales,
total_quantity,
total_products,
last_order_date, 
Span,
CASE WHEN Span >= 12 AND total_sales > 5000 THEN 'VIP'
     WHEN Span >= 12 AND total_sales <= 5000 THEN 'Regular'
     ELSE 'New'
END AS cust_category,
CASE WHEN age < 20 THEN 'Below 20'
	 WHEN age between 20 AND 40 THEN '20-40'
	 WHEN age between 40 AND 60 THEN '40-60'
	 ELSE 'Above 60'
END age_category,
DATEDIFF(Day, last_order_date, GETDATE()) AS recency,
--Average Order Value
CASE WHEN total_sales=0 THEN 0
	 ELSE total_sales/total_orders 
END AS Avg_order_value,
--Average monthly spend
CASE WHEN span=0 THEN total_sales
	 ELSE total_sales/total_orders 
END AS Avg_monthly_spend
FROM cte_customer_aggregation
)
SELECT *
FROM cte_partition

SELECT*
FROM Gold.report_view_customer
GROUP BY product_surkey,
)

SELECT *
FROM cte_base_query
